<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Nanodot</string>
    <key>CFBundleDisplayName</key><string>Nanodot</string>
    <!-- 元の言語は日本語。訳は Resources/*.xcstrings にあり、ビルドのときに ja.lproj / en.lproj になる。
         システムの言語に従い、開く・保存パネルなどシステムの部品も同じ言語になる。App Store の対応言語には日本語・英語と出る -->
    <key>CFBundleDevelopmentRegion</key><string>ja</string>
    <key>CFBundleLocalizations</key><array><string>ja</string><string>en</string></array>
    <key>CFBundleIdentifier</key><string>com.hashrock.nanodot</string>
    <key>CFBundleExecutable</key><string>Nanodot</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>0.5.0</string>
    <key>CFBundleVersion</key><string>5</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.graphics-design</string>
    <!-- 暗号を使わない（輸出コンプライアンスの申告） -->
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>PNG Image</string>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key><array><string>public.png</string></array>
        </dict>
        <!-- サイドカー（<名前>.nanodot）。App Sandbox で PNG の隣に読み書きするための関連ファイルの宣言。
             Role が Editor でないと書けない（None / Viewer は読み取りだけ）。
             LSHandlerRank を None にして、Finder の「このアプリケーションで開く」の候補には出さない -->
        <dict>
            <key>CFBundleTypeName</key><string>Nanodot Sheet Settings</string>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>LSHandlerRank</key><string>None</string>
            <key>LSItemContentTypes</key><array><string>com.hashrock.nanodot.sheet-settings</string></array>
            <key>NSIsRelatedItemType</key><true/>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>com.hashrock.nanodot.sheet-settings</string>
            <key>UTTypeDescription</key><string>Nanodot Sheet Settings</string>
            <key>UTTypeConformsTo</key><array><string>public.json</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key><array><string>nanodot</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
